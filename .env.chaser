# Chaser drone: carries the Z-1Mini gimbal (sakura USART2 = PD5 TX / PD6 RX,
# 115200) + UM982, and aims the camera at the leader.
# Activate with:  cp .env.chaser .env  &&  just flash
#
# These env vars OVERRIDE the vehicle YAML's build: section (the feature
# script warns on each divergence). Longer-term the chaser deserves its
# own vehicles/*.yaml with these values in build:.
ROLE=chaser
BOARD=sakurah743
POS_SOURCE=gps
GPS_MODEL=unicore
VEHICLE=sakura_bench
