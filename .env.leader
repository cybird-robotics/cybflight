# Leader drone: unchanged airframe that broadcasts its pose to the chaser
# (enable with `param set peer_pose_en 1` or pin it in the vehicle YAML).
# Activate with:  cp .env.leader .env  &&  just build
#
# These env vars OVERRIDE the vehicle YAML's build: section (the feature
# script warns on each divergence). Longer-term the leader deserves its
# own vehicles/*.yaml with these values in build:.
ROLE=leader
BOARD=sakurah743
POS_SOURCE=gps
GPS_MODEL=ublox
VEHICLE=sakura_bench
